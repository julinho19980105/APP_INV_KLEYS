
{
  "entities": {
    "Product": {
      "title": "Producto",
      "description": "Prenda de ropa en el inventario",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Código único del producto" },
        "name": { "type": "string", "description": "Nombre de la prenda" },
        "category": { "type": "string", "description": "Categoría de moda" },
        "collection": { "type": "string", "description": "Colección de temporada" },
        "stock": { "type": "number", "description": "Cantidad disponible total" },
        "priceFardo": { "type": "number", "description": "Precio por fardo" },
        "priceMayor": { "type": "number", "description": "Precio al por mayor" },
        "priceUnidad": { "type": "number", "description": "Precio por unidad" },
        "images": { "type": "array", "items": { "type": "string" }, "description": "URLs de imágenes en Drive" },
        "description": { "type": "string", "description": "Descripción estética" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "name", "category", "collection", "stock"]
    },
    "Customer": {
      "title": "Cliente",
      "description": "Datos de cliente",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "CL-001..." },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Movement": {
      "title": "Movimiento de Inventario",
      "description": "Registro de entrada o salida de stock",
      "type": "object",
      "properties": {
        "productCode": { "type": "string" },
        "type": { "type": "string", "enum": ["in", "out", "return"] },
        "quantity": { "type": "number" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "referenceId": { "type": "string", "description": "ID de boleta o referencia" }
      }
    },
    "Quote": {
      "title": "Cotización / Venta",
      "description": "Registro de proforma o venta finalizada",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "B-001..." },
        "customerName": { "type": "string" },
        "customerId": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "annulled", "shipped"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Payment": {
      "title": "Pago",
      "description": "Registro de cobro a cliente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "amount": { "type": "number" },
        "bankId": { "type": "string" },
        "bankName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "isLocked": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AppConfig": {
      "title": "Configuración de Aplicación",
      "description": "Configuración global de la identidad",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "companyLogo": { "type": "string" },
        "brandColor": { "type": "string" },
        "inventoryViewMode": { "type": "string" },
        "printerWidth": { "type": "string", "enum": ["58", "80"] },
        "banks": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "isDefault": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Inventario maestro"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Cartera de clientes"
    },
    "/quotes/{quoteId}": {
      "schema": "Quote",
      "description": "Registro de cotizaciones y ventas"
    },
    "/movements/{movementId}": {
      "schema": "Movement",
      "description": "Kardex de stock"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Registro de cobros"
    },
    "/config/{configId}": {
      "schema": "AppConfig",
      "description": "Ajustes de identidad y sistema"
    }
  }
}
