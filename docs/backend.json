
{
  "entities": {
    "Product": {
      "title": "Producto",
      "description": "Prenda de ropa en el inventario",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Código único del producto" },
        "name": { "type": "string", "description": "Nombre de la prenda" },
        "category": { "type": "string", "description": "Categoría de moda" },
        "collection": { "type": "string", "description": "Colección de temporada" },
        "stock": { "type": "number", "description": "Cantidad disponible actual" },
        "baseStock": { "type": "number", "description": "Stock inicial o base ajustada" },
        "priceFardo": { "type": "number", "description": "Precio por fardo" },
        "priceMayor": { "type": "number", "description": "Precio al por mayor" },
        "priceUnidad": { "type": "number", "description": "Precio por unidad" },
        "images": { "type": "array", "items": { "type": "string" }, "description": "URLs de imágenes" },
        "description": { "type": "string", "description": "Descripción estética" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "name", "category", "collection", "stock"]
    },
    "Customer": {
      "title": "Cliente",
      "description": "Datos de cliente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Movement": {
      "title": "Movimiento",
      "description": "Registro de stock",
      "type": "object",
      "properties": {
        "productCode": { "type": "string" },
        "type": { "type": "string", "enum": ["in", "out", "return"] },
        "quantity": { "type": "number" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Quote": {
      "title": "Venta",
      "description": "Registro de ventas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/products/{productId}": { "schema": "Product", "description": "Inventario maestro" },
    "/customers/{customerId}": { "schema": "Customer", "description": "Cartera de clientes" },
    "/quotes/{quoteId}": { "schema": "Quote", "description": "Registro de ventas" },
    "/movements/{movementId}": { "schema": "Movement", "description": "Histórico de stock" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Registro de cobros" },
    "/dayLocks/{dateKey}": { "schema": "DayLock", "description": "Cierres diarios" },
    "/logistics/{dateKey}": { "schema": "LogisticsBatch", "description": "Lotes de envío" },
    "/config/{configId}": { "schema": "AppConfig", "description": "Ajustes globales" }
  }
}
